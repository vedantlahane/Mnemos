{
  "name": "extension",
  "version": "0.0.1",
  "description": "AI-powered knowledge capture",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "displayName": "Mnemos",
  "manifest": {
    "commands": {
      "save-selection": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "Save selected text to Mnemos"
      }
    },
    "permissions": ["contextMenus", "activeTab"],
    "host_permissions": [
      "https://*/*",
      "http://localhost:8000/*"
    ]
  }
}
